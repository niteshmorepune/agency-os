generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Agency & Branding
model Agency {
  id                 String         @id @default(cuid())
  name               String
  logoUrl            String?
  primaryColor       String         @default("#1a472a")
  accentColor        String         @default("#c8522a")
  fontFamily         String         @default("Inter")
  reportFooter       String?
  reportTagline      String?
  faviconUrl         String?
  customDomain       String?
  // API Keys (all AES-256 encrypted)
  ahrefsKey          String?
  dataforseKey       String?
  psiApiKey          String?
  anthropicKey       String?
  gscClientId        String?
  gscClientSecret    String?
  smtpHost           String?
  smtpUser           String?
  smtpPass           String?
  aiMonthlyBudgetUsd Float          @default(20)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  users              User[]
  clients            Client[]
  digests            AgencyDigest[]
  webhooks           Webhook[]
}

// Users
model User {
  id               String             @id @default(cuid())
  agencyId         String
  agency           Agency             @relation(fields: [agencyId], references: [id])
  email            String             @unique
  name             String
  role             Role               @default(AUDITOR)
  avatarUrl        String?
  passwordHash     String
  lastLoginAt      DateTime?
  isActive         Boolean            @default(true)
  failedLoginCount Int                @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  assignments      ClientAssignment[]
  notes            AuditNote[]
  postDrafts       PostDraft[]
  activities       ActivityLog[]
  aiUsage          AIUsageLog[]
  refreshTokens    RefreshToken[]
  approvedPosts    PostDraft[]        @relation("PostApprovals")
  notifications    Notification[]
}

enum Role {
  OWNER
  ACCOUNT_MANAGER
  CONTENT_CREATOR
  SEO_ANALYST
  CLIENT
  AUDITOR
}

// Refresh Tokens (hashed, rotated)
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Clients
model Client {
  id                    String                 @id @default(cuid())
  agencyId              String
  agency                Agency                 @relation(fields: [agencyId], references: [id])
  name                  String
  domain                String
  brandName             String?
  industry              String?
  targetAudience        String?
  competitors           String[]
  monthlyRetainer       Float?
  contactName           String?
  contactEmail          String?
  notes                 String?
  status                ClientStatus           @default(ACTIVE)
  aiMonthlyBudgetUsd    Float?
  onboardingComplete    Boolean                @default(false)
  onboardingData        Json?
  onboardingCompletedAt DateTime?
  brandTone             String?
  wordsToAvoid          String?
  primaryLocation       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignments           ClientAssignment[]
  auditProjects         AuditProject[]
  platformScores        PlatformOptimization[]
  personas              AudiencePersona[]
  competitorData        CompetitorProfile[]
  postDrafts            PostDraft[]
  reports               GeneratedReport[]
  hashtagSets           HashtagSet[]
  contentIdeas          ContentIdea[]
  aiUsage               AIUsageLog[]
  mediaAssets           MediaAsset[]
  invoices              Invoice[]
  reportSchedule        ReportSchedule         @default(NONE)
  lastReportEmailedAt   DateTime?
  actionItems           ClientActionItem[]
  messages              ClientMessage[]
  onboardingToken       OnboardingToken?
  socialAccounts        SocialAccount[]
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

// Team Assignments
model ClientAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
}

// ─── Audit Module ────────────────────────────────────────────────────────────

model AuditProject {
  id                String       @id @default(cuid())
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  status            AuditStatus  @default(IN_PROGRESS)
  overallScore      Int?
  competitorDomains String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  checks            AuditCheck[]
  notes             AuditNote[]
}

enum AuditStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model AuditCheck {
  id            String           @id @default(cuid())
  auditId       String
  audit         AuditProject     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  moduleId      String // e.g. "website_seo", "social_media"
  checkId       String // e.g. "ssl_check", "pagespeed"
  status        AuditCheckStatus @default(PENDING)
  score         Int?
  weight        Int              @default(1)
  data          Json?
  aiSuggestion  String?
  lastCheckedAt DateTime?
  updatedAt     DateTime         @updatedAt
  notes         AuditNote[]
}

enum AuditCheckStatus {
  PENDING
  PASS
  WARN
  FAIL
  NA
}

model AuditNote {
  id         String        @id @default(cuid())
  auditId    String?
  audit      AuditProject? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  checkId    String?
  auditCheck AuditCheck?   @relation(fields: [checkId], references: [id], onDelete: SetNull)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  content    String
  isInternal Boolean       @default(true)
  mentions   String[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─── Platform Optimization ────────────────────────────────────────────────────

model PlatformOptimization {
  id           String                 @id @default(cuid())
  clientId     String
  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform     Platform
  score        Int                    @default(0)
  updatedAt    DateTime               @updatedAt
  createdAt    DateTime               @default(now())
  checks       PlatformCheck[]
  scoreHistory PlatformScoreHistory[]

  @@unique([clientId, platform])
}

enum Platform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  GBP
  YOUTUBE
  TWITTER
  TIKTOK
  PINTEREST
  GOOGLE_ADS
  EMAIL
  WHATSAPP
}

model PlatformCheck {
  id             String               @id @default(cuid())
  optimizationId String
  optimization   PlatformOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)
  checkId        String
  status         CheckStatus          @default(PENDING)
  score          Int?
  notes          String?
  aiSuggestion   String?
  manualInput    String?
  updatedAt      DateTime             @updatedAt
  createdAt      DateTime             @default(now())

  @@unique([optimizationId, checkId])
}

enum CheckStatus {
  PENDING
  PASS
  WARN
  FAIL
  NA
}

model PlatformScoreHistory {
  id             String               @id @default(cuid())
  optimizationId String
  optimization   PlatformOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)
  score          Int
  recordedAt     DateTime             @default(now())
}

// ─── Content Studio ───────────────────────────────────────────────────────────

model PostDraft {
  id                   String              @id @default(cuid())
  clientId             String
  client               Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User                @relation(fields: [createdById], references: [id])
  platforms            Platform[]
  caption              String
  hashtags             String[]
  mediaUrls            String[]
  altTexts             String[]
  platformOverrides    Json?
  scheduledAt          DateTime?
  status               PostStatus          @default(DRAFT)
  approvalStatus       ApprovalStatus      @default(PENDING)
  approvedById         String?
  approvedBy           User?               @relation("PostApprovals", fields: [approvedById], references: [id])
  notes                String              @default("")
  aiGenerated          Boolean             @default(false)
  performance          Json?
  clientReviewStatus   ClientReviewStatus?
  clientFeedback       String?
  publishedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientReviewStatus {
  CLIENT_APPROVED
  CHANGES_REQUESTED
}

model ContentIdea {
  id         String     @id @default(cuid())
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform   Platform
  title      String
  format     String
  hook       String
  outline    String
  status     IdeaStatus @default(SAVED)
  usedInPost String?
  createdAt  DateTime   @default(now())
}

enum IdeaStatus {
  SAVED
  USED
  REJECTED
}

// ─── Social Publishing ────────────────────────────────────────────────────────

model SocialAccount {
  id             String    @id @default(cuid())
  agencyId       String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform       Platform
  accountName    String
  accountId      String    // Page ID / IG Business ID / LinkedIn URN suffix
  accessToken    String    // AES-256 encrypted
  tokenExpiresAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, platform])
}

model PostPublishLog {
  id             String        @id @default(cuid())
  postId         String
  agencyId       String
  platform       Platform
  status         PublishStatus @default(PENDING)
  publishedUrl   String?
  platformPostId String?
  errorMessage   String?
  attemptedAt    DateTime      @default(now())
}

enum PublishStatus {
  PENDING
  SUCCESS
  FAILED
}

// ─── AI Studio ────────────────────────────────────────────────────────────────

model AIUsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  toolId       String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  cached       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─── Research Tools ───────────────────────────────────────────────────────────

model HashtagSet {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform  Platform
  topic     String
  niche     String?
  hashtags  Json
  createdAt DateTime @default(now())
}

model AudiencePersona {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  demographics    Json
  psychographics  Json
  digitalBehavior Json
  painPoints      String[]
  goals           String[]
  objections      String[]
  contentTriggers String[]
  messagingGuide  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompetitorProfile {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  website       String?
  platforms     Json
  automatedData Json?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// ─── Reports & Activity ───────────────────────────────────────────────────────

model GeneratedReport {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ReportType
  period    String
  pdfUrl    String
  data      Json
  createdAt DateTime   @default(now())
}

enum ReportType {
  MONTHLY
  PLATFORM_SPECIFIC
  AUDIT_ONLY
  CUSTOM
}

// ─── Webhooks ────────────────────────────────────────────────────────────────

model Webhook {
  id             String    @id @default(cuid())
  agencyId       String
  agency         Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name           String
  url            String
  events         String[]
  secret         String
  isActive       Boolean   @default(true)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Digest ──────────────────────────────────────────────────────────────────

enum ReportSchedule {
  NONE
  MONTHLY
}

model AgencyDigest {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  weekLabel String
  content   String
  createdAt DateTime @default(now())
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(cuid())
  agencyId      String
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceNumber String
  title         String
  items         Json
  subtotal      Float         @default(0)
  taxRate       Float         @default(0)
  total         Float         @default(0)
  currency      String        @default("INR")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([agencyId, invoiceNumber])
}

// ─── Media & Templates ───────────────────────────────────────────────────────

model MediaAsset {
  id           String   @id @default(cuid())
  agencyId     String
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime @default(now())
}

model PostTemplate {
  id        String    @id @default(cuid())
  agencyId  String
  name      String
  platform  Platform?
  caption   String
  hashtags  String[]
  category  String?
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id           String   @id @default(cuid())
  agencyId     String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  agencyId  String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  POST_APPROVED
  POST_REJECTED
  AUDIT_COMPLETED
  GENERAL
}

// ─── Client Action Items ──────────────────────────────────────────────────────

model ClientActionItem {
  id            String           @id @default(cuid())
  agencyId      String
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime?
  status        ActionItemStatus @default(PENDING)
  createdById   String
  completedAt   DateTime?
  completedNote String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── In-App Messaging ─────────────────────────────────────────────────────────

model ClientMessage {
  id         String   @id @default(cuid())
  agencyId   String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String
  senderName String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─── Onboarding Token ─────────────────────────────────────────────────────────

model OnboardingToken {
  id        String    @id @default(cuid())
  clientId  String    @unique
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
