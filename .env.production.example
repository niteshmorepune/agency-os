# ── Copy this file to .env.production and fill in real values ─────────────────
# DATABASE_URL must use the Docker service name "postgres", not localhost
DATABASE_URL=postgresql://agencyos_user:CHANGE_ME@postgres:5432/agencyos

# Postgres container password — must match DATABASE_URL above
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — minimum 32 chars, run: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_SECRET_HERE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_MIN_32_CHARS_SECRET

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://nedsdrishti.in

# AES-256 key for API keys stored in DB — run: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_KEY_HERE

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Google APIs (optional)
GOOGLE_PSI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SEO data (optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AHREFS_API_KEY=

# Email (optional — Brevo/SendGrid/etc.)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hello@nedsdrishti.in

# Storage — mapped to Docker volume
UPLOAD_DIR=/app/uploads

# Logging
LOG_LEVEL=info
