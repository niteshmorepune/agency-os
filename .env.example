# Core
DATABASE_URL=postgresql://agencyos_user:password@localhost:5432/agencyos
JWT_SECRET=min-32-chars-secret-here-change-in-production
JWT_REFRESH_SECRET=another-min-32-chars-secret-change-in-production
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Encryption (AES-256 for API keys stored in DB)
ENCRYPTION_KEY=32-char-hex-key-for-aes-256-encryption

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Google APIs (free)
GOOGLE_PSI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SEO data (choose one or both)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AHREFS_API_KEY=

# Email
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hello@youragency.com

# Storage
UPLOAD_DIR=./uploads

# Optional: Redis for caching AI outputs
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Server-to-server integration, scoped per caller (each a distinct secret —
# a leak of one never grants access to the other caller's routes):
# SERVICE_API_KEY_CRM: the NEDS CRM's own provisioning/metrics/usage calls.
#   Must match DRISHTI_SERVICE_KEY in the CRM .env.
# SERVICE_API_KEY_SMDOST: Social Media Dost's content-push call only.
#   Must match DRISHTI_SERVICE_KEY in SMDost's own .env.
SERVICE_API_KEY_CRM=
SERVICE_API_KEY_SMDOST=
# The old unscoped SERVICE_API_KEY has been retired (2026-09-18) — no route
# reads it any more. Safe to remove from the real .env entirely.

# SSO — short-lived JWT secret shared with the NEDS CRM portal for one-click login.
# Must match DRISHTI_SSO_SECRET in the CRM .env.
PORTAL_SSO_SECRET=
